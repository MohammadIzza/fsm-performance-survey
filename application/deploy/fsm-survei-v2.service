[Unit]
Description=Survei Penilaian FSM UNDIP v2 (salinan uji coba pengembangan)
Documentation=file:///home/restart/survey-fsm-v2/application/docs/deployment.md
After=network.target survey-fsm-postgres.service
Requires=survey-fsm-postgres.service

[Service]
Type=simple
User=restart
Group=restart
WorkingDirectory=/home/restart/survey-fsm-v2/application
# next start baca .env dari WorkingDirectory sendiri — tidak perlu EnvironmentFile=.
# .dist-aktif (ditulis deploy/terbitkan.sh) memilih folder build .next-a atau .next-b; tanpa berkas
# itu Next memakai .next.
EnvironmentFile=-/home/restart/survey-fsm-v2/application/.dist-aktif
ExecStart=/home/restart/survey-fsm-v2/application/node_modules/.bin/next start -H 127.0.0.1 -p 3931
Restart=always
RestartSec=5
Environment=NODE_ENV=production
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fsm-survei-v2

[Install]
WantedBy=multi-user.target
