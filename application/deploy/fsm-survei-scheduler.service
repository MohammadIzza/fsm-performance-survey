[Unit]
Description=Survei FSM UNDIP - buka periode terjadwal (Bab 7.2, one-shot; dipicu oleh fsm-survei-scheduler.timer)
Documentation=file:///home/survey/survey-fsm/application/docs/deployment.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=survey
Group=survey
WorkingDirectory=/home/survey/survey-fsm/application
Environment=PATH=/opt/node22/bin:/home/survey/survey-fsm/application/node_modules/.bin:/usr/bin:/bin
ExecStart=/home/survey/survey-fsm/application/node_modules/.bin/tsx scripts/run-scheduled-transitions.ts
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fsm-survei-scheduler
