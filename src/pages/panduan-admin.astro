---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../data/pages';
import Hero from '../components/sections/summer-bootcamps/Hero.astro';
import Interlude from '../components/sections/shared/BubblesInterlude.astro';
import Usps from '../components/sections/summer-bootcamps/Usps.astro';
import Separator from '../components/sections/shared/AnimatedSeparator.astro';
import ContentSlider from '../components/sections/summer-bootcamps/ContentSlider.astro';
import Separator2 from '../components/sections/shared/AnimatedSeparator.astro';
import Courses from '../components/sections/summer-bootcamps/Courses.astro';
import Separator3 from '../components/sections/shared/AnimatedSeparator.astro';
import B2BForm from '../components/sections/summer-bootcamps/B2BForm.astro';
import Faq from '../components/sections/shared/TrainingFaq.astro';
---

<SiteLayout {...pages['panduan-admin']}>
  <Hero />
  <Interlude />
  <Usps />
  <Separator />
  <ContentSlider />
  <Separator2 />
  <Courses />
  <Separator3 />
  <B2BForm />
  <Faq />
  {/* Bagian yang dilepas karena tidak mencerminkan aplikasi: profil tim rekaan dan kartu contoh. */}
</SiteLayout>
