---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../data/pages';
import Hero from '../components/sections/home/Hero.astro';
import VideoHighlight from '../components/sections/home/VideoHighlight.astro';
import Interlude from '../components/sections/shared/BubblesInterlude.astro';
import Usps from '../components/sections/home/Usps.astro';
---

<SiteLayout {...pages['home']}>
  <Hero />
  <VideoHighlight />
  <Interlude />
  <Usps />
  {/* Bagian yang dilepas dari beranda atas permintaan, komponennya tetap ada di
      components/sections/home/ dan tinggal dipasang kembali bila diperlukan:
      Reviews (Peringkat Teratas), SuccessStories (Skenario Pengguna),
      Bootcamps (Periode Penilaian), CoursesList, CoursesList2, ContentSlider,
      Separator2, Content1, dan Youtube (Materi Pendukung). */}
</SiteLayout>
