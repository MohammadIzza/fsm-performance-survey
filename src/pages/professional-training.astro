---
import SiteLayout from '../layouts/SiteLayout.astro';
import { pages } from '../data/pages';
import Hero from '../components/sections/professional-training/Hero.astro';
import CoursesList from '../components/sections/professional-training/CoursesList.astro';
import TestimonialsClients from '../components/sections/professional-training/TestimonialsClients.astro';
import Interlude from '../components/sections/shared/BubblesInterlude.astro';
import Usps from '../components/sections/professional-training/Usps.astro';
import Separator from '../components/sections/shared/AnimatedSeparator.astro';
import ContentSlider from '../components/sections/professional-training/ContentSlider.astro';
import Instructors from '../components/sections/shared/TrainingInstructors.astro';
import Separator2 from '../components/sections/shared/AnimatedSeparator.astro';
import Courses from '../components/sections/professional-training/Courses.astro';
import Separator3 from '../components/sections/shared/AnimatedSeparator.astro';
import B2BForm from '../components/sections/professional-training/B2BForm.astro';
import Faq from '../components/sections/shared/TrainingFaq.astro';
import Catalogue from '../components/sections/shared/CatalogueModal.astro';
import Curriculum from '../components/sections/professional-training/Curriculum.astro';
---

<SiteLayout {...pages['professional-training']}>
  <Hero />
  <CoursesList />
  <TestimonialsClients />
  <Interlude />
  <Usps />
  <Separator />
  <ContentSlider />
  <Instructors />
  <Separator2 />
  <Courses />
  <Separator3 />
  <B2BForm />
  <Faq />
  <Catalogue />
  <Curriculum />
</SiteLayout>
