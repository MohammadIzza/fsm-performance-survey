---
import { withBase } from '../../../utils/url';
---

<div class="s-instructors" data-lg-scroll data-plr-component="s-instructors">
  <div class="s__inner">
    <div class="u-container">
      <div class="s__header">
        <h2 class="s__title t-h-lg" data-lg-reveal="heading">
          Tim Pengelola Sistem
        </h2>
      </div>
      <div class="s__instructors js-instructors" data-lg-reveal>
        <div class="sb-instructor">
          <h3
            class="sb__name t-t-lg js-name"
            data-lg-reveal="letters"
            data-lg-reveal-manual
          >
            Koordinator Instrumen
          </h3>
          <p
            class="sb__bio t-t-sm js-bio"
            data-lg-reveal="text"
            data-lg-reveal-manual
          >
            Menyusun kategori, parameter, indikator, bobot, dan skala; menjaga
            agar setiap versi instrumen tetap dapat ditelusuri dan tidak ditimpa
            setelah dipakai menjawab.
          </p>
          <div class="sb__image">
            <picture
              class="lazy-image__img b-image"
              data-plr-component="b-image"
            >
              <img
                alt=""
                decoding="async"
                height="400"
                loading="lazy"
                src={withBase("/assets/images/avatar-instrumen.svg")}
                width="400"
              />
            </picture>
            <div class="sb__line"></div>
            <div
              class="a-waves sb__waves a-waves--white"
              data-plr-component="a-waves"
            >
            </div>
          </div>
        </div>
        <div class="sb-instructor">
          <h3
            class="sb__name t-t-lg js-name"
            data-lg-reveal="letters"
            data-lg-reveal-manual
          >
            Koordinator Penugasan
          </h3>
          <p
            class="sb__bio t-t-sm js-bio"
            data-lg-reveal="text"
            data-lg-reveal-manual
          >
            Mengatur aturan kelayakan penilai, menjalankan pengacakan merata,
            serta menyiapkan penutupan dan finalisasi periode.
          </p>
          <div class="sb__image">
            <picture
              class="lazy-image__img b-image"
              data-plr-component="b-image"
            >
              <img
                alt=""
                decoding="async"
                height="400"
                loading="lazy"
                src={withBase("/assets/images/avatar-penugasan.svg")}
                width="400"
              />
            </picture>
            <div class="sb__line"></div>
            <div
              class="a-waves sb__waves a-waves--white"
              data-plr-component="a-waves"
            >
            </div>
          </div>
        </div>
        <div class="s__shape"></div>
        <div class="s__mask"></div>
        <div
          class="a-waves s__waves a-waves--white"
          data-plr-component="a-waves"
        >
        </div>
      </div>
    </div>
  </div>
</div>
