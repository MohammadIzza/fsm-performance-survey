---
import BtnPlain from '../../ui/BtnPlain.astro';
---

<div class="s-form" data-plr-component="s-form">
  <h2
    class="b-marquee b-marquee--pink t-h-2xl"
    style="--duration: 9.72s"
    data-plr-component="b-marquee"
  >
    <span class="b__word"> Ikuti periode penilaian berikutnya </span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ikuti periode penilaian berikutnya"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ikuti periode penilaian berikutnya"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ikuti periode penilaian berikutnya"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ikuti periode penilaian berikutnya"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ikuti periode penilaian berikutnya"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ikuti periode penilaian berikutnya"></span>
  </h2>
  <div class="u-container">
    <section class="b-form" data-plr-component="b-form">
      <p class="b__title t-h-4xs">
        ID penilai dan pimpinan disiapkan oleh admin, bukan pendaftaran
        mandiri. Sudah memiliki ID? Masuk untuk mengisi penilaian. Belum
        punya akses? Hubungi tim pengelola periode.
      </p>
      <div class="form form--links">
        <BtnPlain
          as="a"
          href="/login"
          class="btn-plain--lg"
          label="Masuk Survei"
        />
        <BtnPlain
          as="a"
          href="mailto:up2ti@live.undip.ac.id?subject=Permintaan%20Akses%20Penilai%20atau%20Pimpinan"
          class="btn-plain--lg btn-plain--secondary"
          label="Hubungi Tim Pengelola"
        />
      </div>
    </section>
    <!-- .b-form -->
  </div>
</div>

<style>
  .form--links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .form--links :global(.btn-plain) {
    flex: 1 1 auto;
    text-align: center;
  }
</style>
