      aria-hidden="true"
      class="b__ghost"
      data-title="Join our next bootcamp"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Join our next bootcamp"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Join our next bootcamp"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Join our next bootcamp"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Join our next bootcamp"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Join our next bootcamp"></span>
  </h2>
  <div class="u-container">
    <section class="b-form" data-plr-component="b-form">
      <p class="b__title t-h-4xs">
        Interested in elevating your skills with Nod Coding? Fill out our form,
