<div class="s-reviews" data-plr-component="s-reviews">
  <div class="u-container">
    <h2 class="s__title t-h-4xl">Angka Kunci</h2>
    <ul class="s__reviews js-reviews">
      <li class="s__review">
        <a
          aria-label="Total bobot instrumen: 100 persen"
          class="s__review__link"
          href="/alur-penilaian/"
        >
          <img
            alt=""
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/images/icon-logo-green.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div
                class="s__review__rating__counter js-counter"
                data-note="100"
              >
                100
              </div>
              <div class="u-sr-only">unit</div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
      <li class="s__review">
        <a
          aria-label="Kelompok penilaian terpisah: 2"
          class="s__review__link"
          href="/panduan-pimpinan/"
        >
          <img
            alt=""
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/images/icon-logo-pink.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div class="s__review__rating__counter js-counter" data-note="2">
                2
              </div>
              <div class="u-sr-only">unit</div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
      <li class="s__review">
        <a
          aria-label="Presisi pembanding peringkat: 6 desimal"
          class="s__review__link"
          href="/panduan-admin/"
        >
          <img
            alt=""
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/images/icon-logo-green.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div class="s__review__rating__counter js-counter" data-note="6">
                6
              </div>
              <div class="u-sr-only">unit</div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
    </ul>
  </div>
</div>
