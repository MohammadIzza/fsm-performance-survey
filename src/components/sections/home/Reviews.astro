<div class="s-reviews" data-plr-component="s-reviews">
  <div class="u-container">
    <h2 class="s__title t-h-sm">Peringkat Teratas</h2>
    <ul class="s__reviews js-reviews">
      <li class="s__review">
        <a
          aria-label="Peringkat 1: Dosen A"
          class="s__review__link"
          href="/hasil"
        >
          <img
            alt=""
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/images/icon-crown-gold.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div
                class="s__review__rating__counter s__review__rating__counter--name js-counter"
                data-note="1"
              >
                1. Dosen A
              </div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
      <li class="s__review">
        <a
          aria-label="Peringkat 2: Dosen B"
          class="s__review__link"
          href="/hasil"
        >
          <img
            alt=""
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/images/icon-crown-silver.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div
                class="s__review__rating__counter s__review__rating__counter--name js-counter"
                data-note="2"
              >
                2. Dosen B
              </div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
      <li class="s__review">
        <a
          aria-label="Peringkat 3: Dosen C"
          class="s__review__link"
          href="/hasil"
        >
          <img
            alt=""
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/images/icon-crown-bronze.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div
                class="s__review__rating__counter s__review__rating__counter--name js-counter"
                data-note="3"
              >
                3. Dosen C
              </div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
    </ul>
  </div>
</div>
