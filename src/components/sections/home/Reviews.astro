<div class="s-reviews" data-plr-component="s-reviews">
  <div class="u-container">
    <h2 class="s__title t-h-4xl">Reviews</h2>
    <ul class="s__reviews js-reviews">
      <li class="s__review">
        <a
          aria-label="Course Report: 4.9 out of 5"
          class="s__review__link"
          href="https://www.coursereport.com/schools/nod"
          rel="noopener noreferrer"
          target="_blank"
        >
          <img
            alt="Course Report"
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/media/2024/05/reviews-course-report.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div
                class="s__review__rating__counter js-counter"
                data-note="4.9"
              >
                4.9
              </div>
              <div class="u-sr-only">/5</div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
      <li class="s__review">
        <a
          aria-label="Career Karma: 4.8 out of 5"
          class="s__review__link"
          href="https://careerkarma.com/schools/nod-coding-bootcamp/"
          rel="noopener noreferrer"
          target="_blank"
        >
          <img
            alt="Career Karma"
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/media/2024/05/reviews-career-karma.svg"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div
                class="s__review__rating__counter js-counter"
                data-note="4.8"
              >
                4.8
              </div>
              <div class="u-sr-only">/5</div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
      <li class="s__review">
        <a
          aria-label="Switchup: 4.9 out of 5"
          class="s__review__link"
          href="https://www.switchup.org/bootcamps/nod-coding-bootcamp"
          rel="noopener noreferrer"
          target="_blank"
        >
          <img
            alt="Switchup"
            class="s__review__logo js-logo"
            decoding="async"
            loading="lazy"
            src="/assets/media/2024/05/logo-switchup.png"
          />
          <div class="s__review__rating js-rating">
            <div class="s__review__rating__note js-note">
              <div
                class="s__review__rating__counter js-counter"
                data-note="4.9"
              >
                4.9
              </div>
              <div class="u-sr-only">/5</div>
            </div>
            <div class="s__review__rating__line js-line"></div>
          </div>
        </a>
      </li>
    </ul>
  </div>
</div>
