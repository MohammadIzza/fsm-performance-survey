---
import { withBase } from '../../../utils/url';
---

<div class="s-content-1" data-plr-component="s-content-1">
  <div class="u-container">
    <div class="s__inner">
      <div class="s__content" data-lg-parallax data-lg-parallax-amplitude="0.2">
        <h2 class="s__title t-h-3xs">
          Pimpinan mengisi penilaian sekaligus menelusuri hasil unitnya
        </h2>
        <div class="s__text rte">
          <p>
            Pimpinan unit tetap menerima penugasan seperti penilai lain,
            sehingga sudut pandang kepemimpinan ikut terekam. Perannya sebagai
            pengisi dan sebagai pembaca hasil tetap terpisah.
          </p>
          <p>
            Setelah waktu akses terbuka, pimpinan dapat membuka rekap unitnya
            beserta seluruh subunit, memilih satu kelompok, lalu menelusuri skor
            sampai ke jawaban tiap penilai.
          </p>
        </div>
        <a
          class="btn-plain s__cta"
          href={withBase("/panduan-pimpinan")}
          data-plr-component="btn-plain"
        >
          <span class="btn-plain__inner">
            <span class="btn-plain__text"> Panduan pimpinan </span>
            <span class="btn-plain__arrow"></span>
          </span>
          <svg
            class="btn-plain__background js-background"
            fill="none"
            height="10"
            overflow="visible"
            preserveAspectRatio="none"
            width="10"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
          </svg>
        </a>
      </div>
      <div class="s__illus">
        <div
          class="s__illus__lottie"
          data-lg-lottie={withBase("/assets/lottie/illus-1.json")}
          data-lg-lottie-autoplay
          data-lg-lottie-loop
        >
        </div>
      </div>
    </div>
  </div>
  <div class="s__background"></div>
</div>
