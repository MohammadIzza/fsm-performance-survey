---
import CourseSession from '../../courses/CourseSession.astro';
import { sessions, sessionGroups } from '../../../data/courses';
---

<div class="s-bootcamps" data-plr-component="s-bootcamps">
  <div class="s__top js-top">
    <div class="u-container">
      <div class="s__header js-header" data-lg-reveal>
        <h2
          class="s__title t-h-xl js-title"
          data-lg-reveal="letters"
          data-lg-reveal-manual
        >
          Periode Penilaian
        </h2>
        <p class="s__intro js-intro">
          Periode berjalan beserta kategori penilaian yang tercakup di dalamnya.
        </p>
      </div>
    </div>
    <div
      class="b-hills s__illus"
      data-lg-scroll
      data-lg-scroll-end="0.3"
      data-lg-scroll-start="1"
      data-plr-component="b-hills"
    >
      <div class="b__discs">
        <div class="b__disc"></div>
        <div class="b__disc"></div>
        <div class="b__disc"></div>
        <div class="b__disc"></div>
        <div class="b__disc"></div>
        <div class="b__disc"></div>
      </div>
      <svg
        fill="none"
        height="401"
        viewBox="0 0 1920 401"
        width="1920"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g class="b__row js-row">
          <g>
            <path
              class="b__line js-line"
              d="M1267 336.696C1381.14 267.696 1500.28 228.696 1675.99 221.196C1858.21 217.696 1964.34 261.196 2098 335.696"
              stroke="#383030"></path>
            <path
              class="b__line js-line"
              d="M1251.09 337.002C1121.27 252.002 782.023 127 424.09 333.502"
              stroke="#383030"></path>
            <path
              class="b__line js-line"
              d="M-422.4 337.662C-308.263 268.662 -189.12 229.662 -13.4082 222.162C168.811 218.662 274.939 262.162 408.6 336.662"
              stroke="#383030"></path>
          </g>
          <g>
            <circle
              class="b__dot js-dot"
              cx="1259.09"
              cy="341"
              r="9"
              stroke="#383030"></circle>
            <circle
              class="b__dot js-dot"
              cx="417.09"
              cy="341"
              r="9"
              stroke="#383030"></circle>
          </g>
        </g>
      </svg>
    </div>
  </div>
  <div class="u-container">
    <div class="s__price t-t-lg">
      Skala bawaan 0-100 dengan total bobot parameter tepat 100%.
    </div>
    <ul class="s__bootcamps js-bootcamps">
      {
        sessionGroups['periodePenilaian'].map((key) => (
          <CourseSession session={sessions[key]} />
        ))
      }
    </ul>
    <small class="s__legal">
      Minimum respons per kelompok ditetapkan admin; objek di bawah minimum
      tetap muncul di rekap tanpa peringkat sah.
    </small>
  </div>
</div>
