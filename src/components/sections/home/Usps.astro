---
import { withBase } from '../../../utils/url';
---

<div class="s-usps s-usps--layout-1" data-plr-component="s-usps">
  <div class="u-container">
    <div
      class="s__header js-header"
      data-lg-scroll
      data-lg-scroll-end="0.2"
      data-lg-scroll-start="1"
    >
      <div class="s__header-content">
        <h2 class="s__title t-h-3xl">Mengapa sistem ini?</h2>
      </div>
    </div>
    <div class="s__usps">
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Kategori tanpa ubah kode
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Kategori, parameter, bobot, dan skala disusun admin dari antarmuka,
            tanpa perubahan kode.
          </p>
        </div>
        <div class="sb__illus sb__illus--tech-stack">
          <div
            class="sb__illus__lottie"
            data-lg-lottie={withBase("/assets/lottie/usp-tech-stack.json")}
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Penugasan acak yang merata
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Sistem menyusun calon penilai yang sah, membagi tugas sambil
            meratakan beban, dan menampilkan kekurangan secara terbuka. Menilai
            diri sendiri selalu dilarang.
          </p>
        </div>
        <div class="sb__illus sb__illus--project">
          <div
            class="sb__illus__lottie"
            data-lg-lottie={withBase("/assets/lottie/usp-project.json")}
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Dua hasil yang tidak bercampur
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Penilaian pimpinan dan selain pimpinan memakai instrumen yang sama
            namun dihitung serta diranking terpisah, tanpa pembobotan gabungan.
          </p>
        </div>
        <div class="sb__illus sb__illus--learning">
          <div
            class="sb__illus__lottie"
            data-lg-lottie={withBase("/assets/lottie/usp-learning.json")}
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Hasil yang bisa dipertanggungjawabkan
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Setiap nilai akhir bisa dihitung ulang kapan pun, dan setiap
            koreksi tercatat jelas.
          </p>
        </div>
        <div class="sb__illus sb__illus--hired">
          <div class="b-usp-hired" data-plr-component="b-usp-hired">
            <div class="b__eye js-eye">
              <div class="b__pupil" data-lg-mouse data-lg-mouse-inertia="0.05">
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="s__cta">
        <a
          class="btn-plain s__cta__btn btn-plain--lg btn-plain--secondary"
          href={withBase("/login")} data-lg-reload
          data-plr-component="btn-plain"
        >
          <span class="btn-plain__inner">
            <span class="btn-plain__text"> Ajukan Akses </span>
            <span class="btn-plain__arrow"></span>
          </span>
          <svg
            class="btn-plain__background js-background"
            fill="none"
            height="10"
            overflow="visible"
            preserveAspectRatio="none"
            width="10"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
