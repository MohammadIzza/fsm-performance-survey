---
import { withBase } from '../../../utils/url';
---

<div class="s-usps s-usps--layout-1" data-plr-component="s-usps">
  <div class="u-container">
    <div
      class="s__header js-header"
      data-lg-scroll
      data-lg-scroll-end="0.2"
      data-lg-scroll-start="1"
    >
      <div class="s__header-content">
        <h2 class="s__title t-h-3xl">Mengapa sistem ini?</h2>
      </div>
    </div>
    <div class="s__usps">
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Tampilan yang mudah dan intuitif
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Panduan delapan langkah menuntun admin dari menyusun kategori sampai
            menetapkan hasil. Penilai mengisi satu pertanyaan per layar, dan
            drafnya tersimpan sendiri.
          </p>
        </div>
        <div class="sb__illus sb__illus--tech-stack">
          <div
            class="sb__illus__lottie"
            data-lg-lottie={withBase("/assets/lottie/usp-tech-stack.json")}
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Sistem yang aman dan mudah disesuaikan
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Masuk lewat SSO UNDIP atau akun dari admin, dan tiap orang hanya
            melihat yang menjadi lingkupnya. Kategori, aspek, bobot, sampai
            aturan penilai diatur dari antarmuka.
          </p>
        </div>
        <div class="sb__illus sb__illus--project">
          <div
            class="sb__illus__lottie"
            data-lg-lottie={withBase("/assets/lottie/usp-project.json")}
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Pembagian yang acak namun merata dan konsisten
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Sistem menyusun calon penilai yang memenuhi syarat, lalu membagi
            tugas secara acak sambil meratakan beban. Hasilnya bisa dipratinjau
            dulu, dan menilai diri sendiri selalu dilarang.
          </p>
        </div>
        <div class="sb__illus sb__illus--learning">
          <div
            class="sb__illus__lottie"
            data-lg-lottie={withBase("/assets/lottie/usp-learning.json")}
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Hasil yang transparan dan akuntabel
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Nilai pimpinan dan selain pimpinan dihitung terpisah lalu digabung
            menurut bobotnya. Setiap angka bisa ditelusuri sampai ke jawaban
            penilainya, dan tiap koreksi tercatat.
          </p>
        </div>
        <div class="sb__illus sb__illus--hired">
          <div class="b-usp-hired" data-plr-component="b-usp-hired">
            <div class="b__eye js-eye">
              <div class="b__pupil" data-lg-mouse data-lg-mouse-inertia="0.05">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
