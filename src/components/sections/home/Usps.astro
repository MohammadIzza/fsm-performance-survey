<div class="s-usps s-usps--layout-1" data-plr-component="s-usps">
  <div class="u-container">
    <div
      class="s__header js-header"
      data-lg-scroll
      data-lg-scroll-end="0.2"
      data-lg-scroll-start="1"
    >
      <div class="s__header-content">
        <h2 class="s__title t-h-3xl">Why Nod?</h2>
      </div>
    </div>
    <div class="s__usps">
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Job-ready Tech Skills
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Stay ahead of the curve and focus only on learning the skills top
            companies hire for today.
          </p>
        </div>
        <div class="sb__illus sb__illus--tech-stack">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-tech-stack.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Project Based Learning
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Coding is a craft and you need to get your hands dirty to succeed.
            Learn to code by building a portfolio of projects to prove your
            value in a skills-first job market.
          </p>
        </div>
        <div class="sb__illus sb__illus--project">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-project.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Accelerated Onsite Learning
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Learn to code in small groups with expert mentors at an arm’s
            length, interactive lectures and relentless hands-on practice.
          </p>
        </div>
        <div class="sb__illus sb__illus--learning">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-learning.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Land Your Dream Job
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Our bootcamps are designed to fast track you into the tech industry.
            87% of our graduates lands their first job within 6 months.
          </p>
        </div>
        <div class="sb__illus sb__illus--hired">
          <div class="b-usp-hired" data-plr-component="b-usp-hired">
            <div class="b__eye js-eye">
              <div class="b__pupil" data-lg-mouse data-lg-mouse-inertia="0.05">
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="s__cta">
        <a
          class="btn-plain s__cta__btn btn-plain--lg btn-plain--secondary"
          href="#apply-now"
          data-plr-component="btn-plain"
        >
          <span class="btn-plain__inner">
            <span class="btn-plain__text"> Apply Now </span>
            <span class="btn-plain__arrow"></span>
          </span>
          <svg
            class="btn-plain__background js-background"
            fill="none"
            height="10"
            overflow="visible"
            preserveAspectRatio="none"
            width="10"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
