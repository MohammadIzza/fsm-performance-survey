---
import CourseSession from '../../courses/CourseSession.astro';
import { sessions, sessionGroups } from '../../../data/courses';
---

<div
  class="s-courses-list section-b2b-courses s-courses-list--light"
  data-plr-component="s-courses-list"
>
  <div class="s__top js-top">
    <div class="u-container">
      <div class="s__header js-header" data-lg-reveal>
        <h2
          class="s__title t-h-md js-title"
          data-lg-reveal="letters"
          data-lg-reveal-manual
        >
          Kategori Unit dan Karya
        </h2>
        <p class="s__intro js-intro">
          Empat kategori dengan objek program studi dan karya video,
          masing-masing berpenanggung jawab.
        </p>
      </div>
    </div>
  </div>
  <div class="u-container">
    <ul class="s__courses js-courses">
      {
        sessionGroups['kategoriUnitKarya'].map((key) => (
          <CourseSession session={sessions[key]} />
        ))
      }
    </ul>
  </div>
</div>
