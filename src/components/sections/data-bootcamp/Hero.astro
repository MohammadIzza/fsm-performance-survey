          >
            <circle cx="50" cy="50" fill="none" r="25" stroke-width="50"
            ></circle>
          </svg>
        </div>
        <div class="b__pie b__pie--3 js-pie">
          <svg
            fill="none"
            height="100"
            overflow="visible"
            preserveAspectRatio="none"
            viewBox="0 0 100 100"
