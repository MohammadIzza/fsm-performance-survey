<div class="s-content-slider" data-plr-component="s-content-slider">
  <div class="u-container">
    <div
      class="b-heading-shapes-1 has-text"
      data-lg-reveal
      data-plr-component="b-heading-shapes-1"
    >
      <div class="b__content">
        <h2 class="b__title t-h-md">
          <span
            class="b__title__inner js-title"
            data-lg-reveal="heading"
            data-lg-reveal-manual
          >
            Alur bagi pimpinan
          </span>
          <span class="b__shape-1"></span>
        </h2>
        <p class="b__text">Tiga langkah dari mengisi sampai membaca hasil</p>
      </div>
      <div class="b__shape-2">
        <div class="b__shape-2__circle"></div>
        <div class="b__shape-2__triangle"></div>
      </div>
    </div>
    <div
      class="b-slider-content b-slider-content--style-2"
      data-lg-reveal
      data-plr-component="b-slider-content"
    >
      <div class="b__slides js-slides">
        <div class="a-strips" data-plr-component="a-strips"></div>
        <div
          class="b__slide sb-slide sb-slide--text is-active js-slide"
          data-slide="0"
        >
          <div class="sb__inner">
            <div class="sb__content">
              <h2 class="sb__title t-h-4xs">
                <span class="a-bullet-point"></span>Mengisi Tugas Sendiri
              </h2>
              <div class="sb__text t-t-sm">
                Pimpinan tetap menerima penugasan seperti penilai lain dan
                mengisi formulir dengan aturan yang sama: seluruh parameter
                wajib terisi, draf tidak dihitung, dan jawaban terkunci setelah
                dikirim.
              </div>
            </div>
            <div class="b__loader">
              <div class="b__loader__shape"></div>
              <div class="b__loader__shape"></div>
            </div>
          </div>
          <div class="sb__image">
            <picture
              class="lazy-image__img b-image"
              data-lg-parallax="child"
              data-lg-parallax-amplitude="-1"
              data-plr-component="b-image"
            >
              <img
                alt=""
                decoding="async"
                height="518"
                loading="lazy"
                src="/assets/images/step-catalog.svg"
                width="480"
              />
            </picture>
          </div>
        </div>
        <div class="b__slide sb-slide sb-slide--text js-slide" data-slide="1">
          <div class="sb__inner">
            <div class="sb__content">
              <h2 class="sb__title t-h-4xs">
                <span class="a-bullet-point"></span>

                Menunggu Waktu Akses
              </h2>
              <div class="sb__text t-t-sm">
                Hasil baru dapat dibuka sesuai kebijakan periode: selama aktif,
                setelah ditutup, setelah final, atau pada waktu tertentu.
                Bawaannya setelah final, dan hanya admin atau Dekan yang dapat
                mengubahnya.
              </div>
            </div>
          </div>
          <div class="sb__image">
            <picture
              class="lazy-image__img b-image"
              data-lg-parallax="child"
              data-lg-parallax-amplitude="-1"
              data-plr-component="b-image"
            >
              <img
                alt=""
                decoding="async"
                height="518"
                loading="lazy"
                src="/assets/images/step-meeting.svg"
                width="480"
              />
            </picture>
          </div>
        </div>
        <div class="b__slide sb-slide sb-slide--text js-slide" data-slide="2">
          <div class="sb__inner">
            <div class="sb__content">
              <h2 class="sb__title t-h-4xs">
                <span class="a-bullet-point"></span>

                Menelusuri Hasil
              </h2>
              <div class="sb__text t-t-sm">
                Pilih kategori, kelompok, dan lingkup unit. Judul lingkup selalu
                ditampilkan agar peringkat lokal tidak disalahartikan sebagai
                peringkat fakultas.
              </div>
            </div>
          </div>
          <div class="sb__image">
            <picture
              class="lazy-image__img b-image"
              data-lg-parallax="child"
              data-lg-parallax-amplitude="-1"
              data-plr-component="b-image"
            >
              <img
                alt=""
                decoding="async"
                height="518"
                loading="lazy"
                src="/assets/images/step-course.svg"
                width="480"
              />
            </picture>
          </div>
        </div>
      </div>
      <div class="b__pagination">
        <ul class="b__pages">
          <li class="b__page">
            <button class="b__page__button is-active js-page" data-page="0">
              1
            </button>
          </li>
          <li class="b__page">
            <button class="b__page__button js-page" data-page="1"> 2 </button>
          </li>
          <li class="b__page">
            <button class="b__page__button js-page" data-page="2"> 3 </button>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>
