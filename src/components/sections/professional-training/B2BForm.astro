---
import ContactForm from '../../../components/forms/ContactForm.astro';
---

<div class="s-form" id="b2b-form" data-plr-component="s-form">
  <h2
    class="b-marquee b-marquee--pink t-h-2xl"
    style="--duration: 16.12s"
    data-plr-component="b-marquee"
  >
    <span class="b__word"> Let's Customize Your Training Solution </span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Let's Customize Your Training Solution"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Let's Customize Your Training Solution"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Let's Customize Your Training Solution"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Let's Customize Your Training Solution"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Let's Customize Your Training Solution"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Let's Customize Your Training Solution"></span>
  </h2>
  <div class="u-container">
    <section class="b-form" data-plr-component="b-form">
      <p class="b__title t-h-4xs">
        Interested in elevating your team with Nod? Fill out our contact form,
        and let’s tailor a course to your needs.
