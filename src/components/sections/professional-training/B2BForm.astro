---
import { withBase } from '../../../utils/url';
import BtnPlain from '../../ui/BtnPlain.astro';
---

<div class="s-form" id="b2b-form" data-plr-component="s-form">
  <h2
    class="b-marquee b-marquee--pink t-h-2xl"
    style="--duration: 16.12s"
    data-plr-component="b-marquee"
  >
    <span class="b__word"> Butuh bantuan soal akses hasil? </span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Butuh bantuan soal akses hasil?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Butuh bantuan soal akses hasil?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Butuh bantuan soal akses hasil?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Butuh bantuan soal akses hasil?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Butuh bantuan soal akses hasil?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Butuh bantuan soal akses hasil?"></span>
  </h2>
  <div class="u-container">
    <section class="b-form" data-plr-component="b-form">
      <p class="b__title t-h-4xs">
        Waktu akses hasil ditetapkan oleh Dekan per periode. Sudah punya
        akun? Masuk untuk memeriksa status akses Anda, atau hubungi tim
        pengelola bila akses belum terbuka sesuai jadwal.
      </p>
      <div class="form form--links">
        <BtnPlain
          as="a"
          href={withBase("/login")}
          class="btn-plain--lg"
          label="Masuk Survei"
        />
        <BtnPlain
          as="a"
          href="mailto:up2ti@live.undip.ac.id?subject=Akses%20Hasil%20Pimpinan"
          class="btn-plain--lg btn-plain--secondary"
          label="Hubungi Tim Pengelola"
        />
      </div>
    </section>
  </div>
</div>

<style>
  .form--links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .form--links :global(.btn-plain) {
    flex: 1 1 auto;
    text-align: center;
  }
</style>
