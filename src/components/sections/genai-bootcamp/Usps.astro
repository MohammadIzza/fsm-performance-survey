<div class="s-usps s-usps--layout-2" data-plr-component="s-usps">
  <div class="u-container">
    <div class="s__header js-header" data-lg-reveal>
      <div class="s__header-content">
        <h2 class="s__title t-h-xs">Skills that open doors</h2>
      </div>
      <div class="s__header__masks">
        <div class="s__header__mask"></div>
        <div class="s__header__mask"></div>
        <div class="s__header__mask"></div>
      </div>
      <div class="a-strips s__strips" data-plr-component="a-strips"></div>
    </div>
    <div class="s__usps">
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">Python</h3>
          <p class="sb__text" data-lg-reveal="text">
            The world’s most popular language, the language of AI. Easy to
            learn, versatile and, in demand.
          </p>
        </div>
        <div class="sb__illus sb__illus--python">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-python.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Software Development
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Learn the necessary skills to land entry positions as a Software
            Developer or Backend Developer.
          </p>
        </div>
        <div class="sb__illus sb__illus--sql">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-sql.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">AI Agents</h3>
          <p class="sb__text" data-lg-reveal="text">
            Learn how to give models the ability to interact directly with the
            world and build agents that take actions, plan, and dynamically
            decide which tools use.
          </p>
        </div>
        <div class="sb__illus sb__illus--ai-agent">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-ai-agent.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">RAG</h3>
          <p class="sb__text" data-lg-reveal="text">
            Learn how to enhance models’ generation by allowing it to retrieve
            data from external data sources and the infrastructure behind it.
            For example, embedding texts, storing vectors and, similarity
            search.
          </p>
        </div>
        <div class="sb__illus sb__illus--rag">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-rag.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">
            Tool Integration
          </h3>
          <p class="sb__text" data-lg-reveal="text">
            Learn to creatively plug into a wide array of tools, like web
            scraping, voice synthesis, image integration, calendars, email.
          </p>
        </div>
        <div class="sb__illus sb__illus--tool-integration">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-tool-integration.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__usp sb-usp">
        <div class="sb__content">
          <h3 class="sb__title t-h-4xs" data-lg-reveal="heading">MCP</h3>
          <p class="sb__text" data-lg-reveal="text">
            Learn Model Context Protocols to build secure, two-way connection
            between data sources and AI-powered tools.
          </p>
        </div>
        <div class="sb__illus sb__illus--workflow">
          <div
            class="sb__illus__lottie"
            data-lg-lottie="/assets/lottie/usp-workflow.json"
            data-lg-lottie-autoplay
            data-lg-lottie-loop
          >
          </div>
        </div>
      </div>
      <div class="s__cta s__cta--has-text">
        <p class="s__cta__text">
          Want to nerd out on all the tech stuff you'll learn at our bootcamp?
          Download the full curriculum to get a detailed overview.
        </p>
        <a
          class="btn-plain s__cta__btn btn-plain--lg"
          href="#curriculum"
          data-plr-component="btn-plain"
        >
          <span class="btn-plain__inner">
            <span class="btn-plain__text"> Request Full Curriculum </span>
            <span class="btn-plain__arrow"></span>
          </span>
          <svg
            class="btn-plain__background js-background"
            fill="none"
            height="10"
            overflow="visible"
            preserveAspectRatio="none"
            width="10"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
            <path
              class="btn-plain__path js-background-path"
              d="M 0 0 L 10 0 L 10 10 L 0 10"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</div>
