---
import BtnPlain from '../../ui/BtnPlain.astro';
---

<div class="s-form" id="b2b-form" data-plr-component="s-form">
  <h2
    class="b-marquee b-marquee--pink t-h-2xl"
    style="--duration: 8.52s"
    data-plr-component="b-marquee"
  >
    <span class="b__word"> Ada kendala konfigurasi? </span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ada kendala konfigurasi?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ada kendala konfigurasi?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ada kendala konfigurasi?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ada kendala konfigurasi?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ada kendala konfigurasi?"></span>
    <span
      aria-hidden="true"
      class="b__ghost"
      data-title="Ada kendala konfigurasi?"></span>
  </h2>
  <div class="u-container">
    <section class="b-form" data-plr-component="b-form">
      <p class="b__title t-h-4xs">
        Hubungi tim pengelola untuk pendampingan penyiapan periode, atau
        masuk ke panel admin bila akun sudah tersedia.
      </p>
      <div class="form form--links">
        <BtnPlain
          as="a"
          href="/login"
          class="btn-plain--lg"
          label="Masuk Survei"
        />
        <BtnPlain
          as="a"
          href="mailto:survei.fsm@undip.ac.id?subject=Kendala%20Konfigurasi%20Periode"
          class="btn-plain--lg btn-plain--secondary"
          label="Hubungi Tim Pengelola"
        />
      </div>
    </section>
  </div>
</div>

<style>
  .form--links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .form--links :global(.btn-plain) {
    flex: 1 1 auto;
    text-align: center;
  }
</style>
