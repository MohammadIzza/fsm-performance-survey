---
import ContactForm from '../../../components/forms/ContactForm.astro';
---

<div class="s-form" id="b2b-form" data-plr-component="s-form">
  <h2
    class="b-marquee b-marquee--pink t-h-2xl"
    style="--duration: 8.52s"
    data-plr-component="b-marquee"
  >
    <span class="b__word"> Don't be a Stranger </span>
    <span aria-hidden="true" class="b__ghost" data-title="Don't be a Stranger"
    ></span>
    <span aria-hidden="true" class="b__ghost" data-title="Don't be a Stranger"
    ></span>
    <span aria-hidden="true" class="b__ghost" data-title="Don't be a Stranger"
    ></span>
    <span aria-hidden="true" class="b__ghost" data-title="Don't be a Stranger"
    ></span>
    <span aria-hidden="true" class="b__ghost" data-title="Don't be a Stranger"
    ></span>
    <span aria-hidden="true" class="b__ghost" data-title="Don't be a Stranger"
    ></span>
  </h2>
  <div class="u-container">
    <section class="b-form" data-plr-component="b-form">
      <p class="b__title t-h-4xs">
        Interested but not sure yet? Fill in the form and drop us a question or,
        reach out to schedule a call with us.
      </p>
      <div class="form">
        <ContactForm formId="form-1146" />
      </div>
    </section>
  </div>
</div>
