---
import definitions from '../../data/forms.json';
import BtnPlain from '../ui/BtnPlain.astro';
import { sessions } from '../../data/courses';
import type { HTMLAttributes } from 'astro/types';
interface Field {
  name: string;
  type: string;
  label: string;
  required: boolean;
  options?: { value: string; label: string }[];
}
interface Props {
  formId: keyof typeof definitions;
}
const { formId } = Astro.props;
const definition = definitions[formId];
const fields: Field[] = definition.fields.map((field) => {
  if (formId === 'form-52' && field.name === 'bootcamp') {
    return {
      ...field,
      options: [
        { value: '', label: 'Select a bootcamp' },
        ...Object.values(sessions).map(({ option }) => ({
          value: option,
          label: option,
        })),
      ],
    };
  }
  return field;
});
---

{
  /* `wpcf7-form` / `wpcf7-form-control` are kept because the theme's
s-form-modal controller resets the form and focuses the first control by
those selectors. */
}
<form class="contact-form wpcf7-form" data-contact-form data-form-id={formId}>
  {
    fields.map((field) => (
      <div class="form__row">
        <label
          class:list={[
            'form__field',
            { 'form-checkbox': field.type === 'checkbox' },
          ]}
        >
          {field.type !== 'checkbox' && (
            <span class="field-label">
              {field.label}
              {field.required && ' *'}
            </span>
          )}
          {field.type === 'textarea' ? (
            <textarea
              class="form__control wpcf7-form-control"
              name={field.name}
              rows="4"
              maxlength="2000"
              required={field.required}
            />
          ) : field.type === 'select' ? (
            <select
              class="form__control wpcf7-form-control"
              name={field.name}
              required={field.required}
            >
              {field.options?.map(({ value, label }) => (
                <option value={value}>{label}</option>
              ))}
            </select>
          ) : (
            <input
              class:list={[
                'form__control',
                'wpcf7-form-control',
                { 'checkbox-control': field.type === 'checkbox' },
              ]}
              type={field.type as HTMLAttributes<'input'>['type']}
              name={field.name}
              required={field.required}
              autocomplete={
                field.type === 'email'
                  ? 'email'
                  : field.type === 'tel'
                    ? 'tel'
                    : field.name === 'fullname'
                      ? 'name'
                      : undefined
              }
              maxlength={field.type === 'checkbox' ? undefined : 400}
            />
          )}
          {field.type === 'checkbox' && <span>{field.label}</span>}
        </label>
      </div>
    ))
  }
  <p class="form-privacy">
    Mohon baca <a href="/kebijakan-privasi/">Kebijakan Privasi</a> sebelum mengirim.
  </p>
  <p class="form-status" role="status" aria-live="polite">
    {
      import.meta.env.PUBLIC_FORM_ENDPOINT
        ? ''
        : 'Pratinjau lokal: formulir ini belum terhubung ke server. Tidak ada data yang dikirim.'
    }
  </p>
  <div class="form__action">
    <BtnPlain
      as="button"
      type="submit"
      class="btn-plain--lg"
      label={definition.submit || 'Send'}
    />
  </div>
  <noscript
    ><p>
      JavaScript diperlukan untuk mengirim formulir ini. Hubungi
      survei.fsm@undip.ac.id untuk bantuan.
    </p></noscript
  >
</form>
