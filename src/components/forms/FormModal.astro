---
import ContactForm from './ContactForm.astro';
import definitions from '../../data/forms.json';

interface Props {
  id: string;
  formId: keyof typeof definitions;
  title: string;
}
const { id, formId, title } = Astro.props;
---

{/* Opacity starts at 0; the s-form-modal controller animates it open. */}
<div
  id={id}
  class="s-form-modal"
  data-lenis-prevent
  style="opacity: 0;"
  data-plr-component="s-form-modal"
>
  <div class="s__inner">
    <section class="b-form" data-plr-component="b-form">
      <p class="b__title t-h-4xs">{title}</p>
      <div class="form">
        <ContactForm formId={formId} />
      </div>
    </section>
    <!-- .b-form -->
    <div class="s-form-modal__close js-close" tabindex="0">
      <div class="s-form-modal__close__line"></div>
      <div class="s-form-modal__close__line"></div>
    </div>
    <!-- .s-form-modal__close -->
  </div>
  <!-- .s__inner -->
  <div class="s__background js-background"></div>
</div>
<!-- .s-form-modal -->
