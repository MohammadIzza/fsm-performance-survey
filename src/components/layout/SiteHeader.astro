---
import { withBase, withoutBase } from '../../utils/url';
import { site } from '../../data/site';
// Tanpa garis miring penutup, seperti tautan di src/data/site.ts, supaya penanda menu aktif
// tidak bergantung pada bentuk alamat yang kebetulan dipakai saat membangun. Awalan situs dilepas
// lebih dulu: tautan di site.ts ditulis tanpa awalan dan baru diberi awalan saat dirender.
const currentPath = withoutBase(Astro.url.pathname).replace(/(.)\/$/, '$1');

// Mirrors the theme's main menu: Home, a "10-week Bootcamps" dropdown holding the
// first two navigation entries, then the remaining entries, contact, and the CTA.
const [genai, data, ...rest] = site.navigation;
const dropdown = [genai, data];
---

<header class="site-head" data-plr-component="site-head">
  <div class="site-head__inner">
    <div class="s__logo">
      <a href={withBase("/")}>
        <img
          src={withBase("/assets/images/hero-home-undip.svg")}
          alt="Survei Penilaian FSM UNDIP"
          width="138"
          height="30"
        />
        <span class="s__logo__label">
          Fakultas Sains dan Matematika<br />Universitas Diponegoro
        </span>
      </a>
    </div>
    <!-- .s__logo -->
    <div class="s__toggle js-nav-toggle">
      <div class="s__toggle__lines">
        <div class="s__toggle__line"></div>
        <div class="s__toggle__line"></div>
      </div>
      <!-- .s__toggle__lines -->
    </div>
    <!-- .s__toggle -->
    <div class="s__wrapper js-wrapper">
      <div class="s__wrapper__inner js-wrapper-inner">
        <div class="nav-main">
          <ul id="menu-main-menu" class="site-head__menu js-nav">
            <li
              class:list={[
                'menu-item--home menu-item js-item',
                { 'current-menu-item': currentPath === '/' },
              ]}
            >
              <a
                href={withBase("/")}
                class="menu-link js-link"
                aria-current={currentPath === '/' ? 'page' : undefined}
              >
                <span class="menu-item__text" data-text="Beranda">Beranda</span>
                <svg
                  width="10"
                  height="10"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  class="menu-item__line js-line"
                  overflow="visible"
                  preserveAspectRatio="none"
                >
                  <path d="M 0 0 L 10 10" class="menu-item__path"></path>
                  <path d="M 0 0 L 10 10" class="menu-item__path"></path>
                </svg>
              </a>
            </li>
            <li class="menu-item menu-item-has-children js-item">
              <a href="#" class="menu-link">
                <span class="menu-item__text" data-text="Panduan Peran"
                  >Panduan Peran<span class="menu-item__arrow">
                    <svg
                      width="10"
                      height="5"
                      viewBox="0 0 10 5"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M1 1L4.82609 4L9 1"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </span>
              </a>
              <ul class="sub-menu">
                {
                  dropdown.map(({ label, href }) => (
                    <li
                      class:list={[
                        'menu-item js-item',
                        { 'current-menu-item': currentPath === href },
                      ]}
                    >
                      <a
                        href={withBase(href)}
                        class="menu-link"
                        aria-current={currentPath === href ? 'page' : undefined}
                      >
                        <span class="menu-item__text" data-text={label}>
                          {label}
                        </span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </li>
            {
              rest.map(({ label, href }) => (
                <li
                  class:list={[
                    'menu-item js-item',
                    { 'current-menu-item': currentPath === href },
                  ]}
                >
                  <a
                    href={withBase(href)}
                    class="menu-link js-link"
                    aria-current={currentPath === href ? 'page' : undefined}
                  >
                    <span class="menu-item__text" data-text={label}>
                      {label}
                    </span>
                    <svg
                      width="10"
                      height="10"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      class="menu-item__line js-line"
                      overflow="visible"
                      preserveAspectRatio="none"
                    >
                      <path d="M 0 0 L 10 10" class="menu-item__path" />
                      <path d="M 0 0 L 10 10" class="menu-item__path" />
                    </svg>
                  </a>
                </li>
              ))
            }
            <li class="menu-item js-item">
              <a href={`mailto:${site.email}`} class="menu-link js-link">
                <span class="menu-item__text" data-text="Kontak">Kontak</span>
                <svg
                  width="10"
                  height="10"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  class="menu-item__line js-line"
                  overflow="visible"
                  preserveAspectRatio="none"
                >
                  <path d="M 0 0 L 10 10" class="menu-item__path"></path>
                  <path d="M 0 0 L 10 10" class="menu-item__path"></path>
                </svg>
              </a>
            </li>
            <li class="btn menu-item js-item">
              <a
                class="btn-plain btn-plain--sm btn-plain--primary"
                href={withBase("/login")} data-lg-reload
                data-plr-component="btn-plain"
              >
                <span class="btn-plain__inner">
                  <span class="btn-plain__text">Masuk Survei</span>
                  <!-- .btn-plain__text -->
                  <span class="btn-plain__arrow"></span>
                </span>
                <!-- .btn-plain__inner -->
                <svg
                  width="10"
                  height="10"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  class="btn-plain__background js-background"
                  overflow="visible"
                  preserveAspectRatio="none"
                >
                  <path
                    d="M 0 0 L 10 0 L 10 10 L 0 10"
                    class="btn-plain__path js-background-path"></path>
                  <path
                    d="M 0 0 L 10 0 L 10 10 L 0 10"
                    class="btn-plain__path js-background-path"></path>
                </svg>
              </a>
            </li>
          </ul>
        </div>
        <!-- .nav-main -->
        <div class="s__wrapper__footer">
          <div class="s__wrapper__footer__background js-background"></div>
          <div class="b-head s__head js-head" data-plr-component="b-head">
            <div
              class="b__eye js-eye"
              data-lg-mouse
              data-lg-mouse-inertia="0.05"
            >
              <div class="b__pupil js-pupill">
                <div class="b__pupil__inner b__pupil__inner--main"></div>
                <div class="b__pupil__inner b__pupil__inner--secondary"></div>
              </div>
              <!-- .b__pupil -->
            </div>
            <!-- .b__eye -->
          </div>
          <!-- .b-head -->
        </div>
        <!-- .s__wrapper__footer -->
      </div>
      <!-- .s__wrapper__inner -->
    </div>
    <!-- .s__wrapper -->
    <div class="s__background"></div>
  </div>
  <!-- .site-head__inner -->
  <div class="s__overlay"></div>
</header>
<!-- .site-head -->

<style>
  .s__logo a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .s__logo__label {
    border-left: 1px solid #dedcd4;
    padding-left: 0.75rem;
    font-size: 0.6875rem;
    line-height: 1.3;
    color: var(--color-black);
  }
  @media only screen and (max-width: 767px) {
    .s__logo__label {
      display: none;
    }
  }
  /* Bar navigasi mobile bawaan tema: pil putih melebar hampir sepanjang layar
     berisi cuma logo kecil + tombol menu bulat 3rem — sisa ruang kosong di
     tengah membuatnya terlihat kebesaran. Kecilkan tombolnya dan beri jarak
     tepi sedikit lebih longgar supaya pilnya tidak menempel ujung layar. */
  @media only screen and (max-width: 576px) {
    :global(.site-head) {
      right: 0.75rem !important;
      left: 0.75rem !important;
    }
    :global(.site-head__inner) {
      padding-left: 1rem !important;
    }
    :global(.site-head .s__toggle) {
      width: 2.5rem !important;
      height: 2.5rem !important;
    }
  }
</style>
