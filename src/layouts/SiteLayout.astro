---
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteLoader from '../components/layout/SiteLoader.astro';
import SiteScrollbar from '../components/layout/SiteScrollbar.astro';
import {
  themeBundles,
  themeScripts,
  themeTransitions,
  themeVersion,
} from '../data/theme-runtime';
import '../styles/fonts.css';
import '../styles/theme.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  layout?: string;
}
const { title, description, layout = 'l-page' } = Astro.props;

// `data-plr-layout` carries the bare layout name; the class keeps the `l-` prefix.
const plrLayout = layout.replace(/^l-/, '');

// Serialised for the inline bootstrap below. Transition keys are rebuilt against
// `location.origin` at runtime because SiteLoader looks them up by absolute URL.
//
// `main.js` references the bare `wpcf7` global unconditionally as part of its
// site-wide init, not only from the (now-removed) form-modal close handler —
// every page throws `wpcf7 is not defined` under strict mode without this
// shim, even pages that never had a modal.
const plrBootstrap = `window.plr=Object.assign(${JSON.stringify({
  tpl_dir: '/assets',
  version: themeVersion,
  ajaxurl: '',
  bundles: themeBundles,
})},{transitions:Object.fromEntries(Object.entries(${JSON.stringify(
  themeTransitions,
)}).map(function(e){return [location.origin+e[0],e[1]]}))});
window.wpcf7=window.wpcf7||{reset:function(f){if(f&&f.reset)f.reset()}};`;
---

<!doctype html>
<html lang="id" data-lg-smooth>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7ef" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/assets/favicon/favicon.svg?v=undip-1"
    />
    <link
      rel="apple-touch-icon"
      href="/assets/favicon/apple-touch-icon.png?v=undip-1"
    />
    <link
      rel="preload"
      href="/assets/fonts/HeyWow-Book.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten</a>
    <div class="site-container">
      <SiteHeader />
      <main
        id="main-content"
        class={layout}
        data-plr-layout={plrLayout}
        data-lg-page
        tabindex="-1"
      >
        <slot />
      </main>
      <SiteFooter />
    </div>
    <!-- .site-container -->
    <SiteLoader />
    <SiteScrollbar />
    <script is:inline set:html={plrBootstrap} />
    {themeScripts.map((src) => <script is:inline src={src} />)}
    <script>
      import '../scripts/hero-fsm';
      import '../scripts/luge-navigation-guard';
    </script>
  </body>
</html>
